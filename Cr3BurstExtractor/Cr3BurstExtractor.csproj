<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <ProjectReference Include="..\Cr3BurstExtractor.Lib\Cr3BurstExtractor.Lib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- Hosts the BackgroundService when launched in service mode. -->
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Generate app.ico once by running the .exe with the generate-icon flag.
             The Condition keeps the build green before that file is generated. -->
        <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    </PropertyGroup>

</Project>
